// Known bad VS Code extension on a device
//
// Fires when an extension seen on a device is on a public list of extensions that were
// pulled for cause: malware, impersonation, spam and so on. It also matches a few poisoned
// releases of real extensions by exact version. One row per device and extension, with a
// Tier column that says how bad the listing is.
//
// Runs:      Every 24 hours (30-day lookback, on purpose)
// Severity:  High for Malware, Medium for Impersonation, Low for Removed for cause
// MITRE:     T1176.002, T1195.001
// Tables:    DeviceFileEvents, DeviceProcessEvents
// Custom details: ExtensionId, Tier
//
// Needs:
//   - Defender for Endpoint Plan 2 on the machines your developers use.
//   - Nothing else. Defender fetches the two lists itself each time the rule runs.
//
// Heads up: VS Code extracts an extension into a folder with a random name and renames it
// afterwards, so the install's own file events don't carry the extension ID. This rule
// looks in four other places. Run "Check your telemetry first (hunt).kql" before you trust
// it. No results doesn't prove a device is clean.
//
// Triage (paste into Recommended actions):
//   - Check Tier, Categories, Versions and EditorFolder. Look the ID up on the marketplace
//     that editor installs from.
//   - Malware: escalate. Find out if the editor ran after the first event and what it
//     started. Plan on rotating the tokens, SSH keys and cloud keys that developer had.
//   - Impersonation or Removed for cause: remove the extension and ask the user where it
//     came from. Escalate if the editor started shells or scripts around the first event.
//   - Close if it's the real extension sideloaded into a fork under a name Open VSX blocks,
//     or if the installed version isn't the bad one.
//
// Based on: VSXSentry by mthcht, Microsoft's removed packages list, Open VSX's extension
// control list and VS Code's source. README.md has the links.

// Tiers this copy alerts on. Save one copy per tier if you want a severity for each.
let AlertTiers = dynamic(["Malware", "Impersonation", "Removed for cause"]);
let Lookback = 30d;
// Removal reasons that are housekeeping. They never alert.
let Housekeeping = dynamic(["owner-request", "publisher-requested", "deprecated", "expired-domain"]);
// Editors that don't install from Microsoft's Marketplace. Fork-only entries apply to these.
let ForkEditors = @"(?i)^(cursor|windsurf|vscodium|codium|vscode-oss|code - oss|kiro|antigravity|trae|positron)";
// Where an extension ID shows up in a path or a command line.
let ExtensionPath = @"(?i)[\\/]\.?([^\\/]+)[\\/](?:data[\\/])?(?:extensions|CachedExtensionVSIXs)[\\/]\.?([^\\/.\s]+\.[^\\/\s]+?)-(\d+\.\d+\.\d+)";
let StoragePath = @"(?i)[\\/]\.?([^\\/]+)[\\/](?:data[\\/])?(?:User[\\/]globalStorage|User[\\/]workspaceStorage[\\/][^\\/]+|logs[\\/][^\\/]+[\\/](?:window\d+[\\/])?exthost\d*)[\\/]([^\\/.\s]+\.[^\\/\s]+)[\\/]";
let CliInstall = @"(?i)--install-extension[=\s]+\W?([a-z0-9][a-z0-9-]*\.[a-z0-9][a-z0-9-]*)";
let PathTerms = dynamic(["extensions", "CachedExtensionVSIXs", "globalStorage", "workspaceStorage", "exthost", "exthost1"]);
// VSXSentry: Microsoft's removals plus community reports. Applies to every editor.
let VsxSentry = externaldata(
        extension_id:string, publisher_id:string, extension_name:string, metadata_comment:string,
        metadata_severity:string, metadata_category:string, metadata_source:string,
        metadata_reference:string, metadata_status:string, removal_date:string)
    [@"https://vsxsentry.github.io/feeds/vsxsentry_malicious_feed.csv"]
    with (format="csv", ignoreFirstRecord=true)
    | project MatchKey = tolower(extension_id), Category = tolower(metadata_category), Scope = "any";
// Open VSX's own block list. Many of its IDs are real extensions on Microsoft's Marketplace,
// so it only applies to forks.
let OpenVsxBlockList = externaldata(malicious:dynamic)
    [@"https://raw.githubusercontent.com/EclipseFdn/publish-extensions/master/extension-control/extensions.json"]
    with (format="multijson", ingestionMapping='[{"Column":"malicious","Properties":{"Path":"$.malicious"}}]')
    | mv-expand malicious to typeof(string)
    | project MatchKey = tolower(malicious), Category = "open-vsx-blocklist", Scope = "fork";
// Your own entries. An ID alone matches every version. id@version matches one release.
// Scope: any = every editor, fork = forks only, cursor = Cursor only.
// The first 3 are IDs that two glued rows in Microsoft's list hide. The next 2 are the
// Solidity Pro stealer. The last 5 are poisoned releases of real extensions.
let ExtraEntries = datatable(MatchKey:string, Category:string, Scope:string) [
    "jonasxwebdev.sftp-dss", "impersonation", "any",
    "comp.java-bazel-extension", "impersonation", "any",
    "gtfish1988.gtfish25-sql-formatter", "impersonation", "any",
    "helper-beeps.solidity-pro", "malware", "any",
    "web3devtoolsx.solidity-pro", "malware", "any",
    "nrwl.angular-console@18.95.0", "poisoned-release", "any",
    "oorzc.ssh-tools@0.5.1", "poisoned-release", "fork",
    "oorzc.i18n-tools-plus@1.6.8", "poisoned-release", "fork",
    "anthropic.claude-code@2.1.312", "poisoned-release", "cursor",
    "anthropic.claude-code@2.1.313", "poisoned-release", "cursor"
];
let KnownBad = union VsxSentry, OpenVsxBlockList, ExtraEntries
    | where isnotempty(MatchKey) and Category !in (Housekeeping) and Category !startswith "risky"
    | extend Rank = case(
        Category contains "malware" or Category in ("potentially-malicious", "poisoned-release"), 1,
        Category in ("impersonation", "typo-squatting", "open-vsx-blocklist"), 2,
        3)
    | distinct MatchKey, Category, Scope, Rank;
let FileEvidence = DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FolderPath has_any (PathTerms)
    | project Timestamp, DeviceId, DeviceName, ReportId,
        AccountName = InitiatingProcessAccountName, AccountSid = InitiatingProcessAccountSid, AccountUpn = InitiatingProcessAccountUpn,
        ProcessName = InitiatingProcessFileName, Source = strcat("File ", ActionType),
        Evidence = iff(FolderPath endswith FileName, FolderPath, strcat(FolderPath, @"\", FileName));
let ProcessEvidence = DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where ProcessCommandLine has_any (PathTerms) or ProcessCommandLine has "install-extension"
        or FolderPath has_any (PathTerms) or InitiatingProcessCommandLine has_any (PathTerms)
    | project Timestamp, DeviceId, DeviceName, ReportId, AccountName, AccountSid, AccountUpn,
        ProcessName = FileName, Source = "Process",
        Evidence = strcat(FolderPath, " ", ProcessCommandLine, " ", InitiatingProcessCommandLine);
union FileEvidence, ProcessEvidence
| extend InFolder = extract(ExtensionPath, 2, Evidence), InStorage = extract(StoragePath, 2, Evidence), InCli = extract(CliInstall, 1, Evidence)
| extend ExtensionId = tolower(case(isnotempty(InFolder), InFolder, isnotempty(InStorage), InStorage, InCli))
| where isnotempty(ExtensionId)
| extend Version = extract(ExtensionPath, 3, Evidence)
| extend MatchKey = pack_array(ExtensionId, strcat(ExtensionId, "@", Version))
| mv-expand MatchKey to typeof(string)
| join kind=inner (KnownBad) on MatchKey
| extend EditorFolder = case(
    isnotempty(InFolder), extract(ExtensionPath, 1, Evidence),
    isnotempty(InStorage), extract(StoragePath, 1, Evidence),
    ProcessName)
| where Scope == "any"
    or (Scope == "fork" and EditorFolder matches regex ForkEditors)
    or (Scope == "cursor" and EditorFolder startswith "cursor")
| extend Signal = strcat(Source, ", ", case(
    isnotempty(InFolder) and Evidence has "CachedExtensionVSIXs", "VSIX cache",
    isnotempty(InFolder), "extension folder",
    isnotempty(InStorage), "storage or log folder",
    "install command"))
| summarize arg_min(Timestamp, *), BestRank = min(Rank),
        Categories = strcat_array(make_set(Category), ", "),
        Versions = strcat_array(make_set_if(Version, isnotempty(Version)), ", "),
        Signals = strcat_array(make_set(Signal), "; ")
    by DeviceId, ExtensionId
| extend Tier = case(BestRank == 1, "Malware", BestRank == 2, "Impersonation", "Removed for cause")
| where Tier in (AlertTiers)
| project Timestamp, DeviceId, DeviceName, ReportId, ExtensionId, Tier, Categories, Versions, EditorFolder, Signals,
    AccountName, AccountSid, AccountUpn, ProcessName, Evidence
