// Extension blocked by Open VSX on a VS Code fork
//
// Fires when a VS Code fork like Cursor, Windsurf or VSCodium has an extension that Open VSX
// blocks. One row per device and extension. It's the second rule in this folder. The main
// one is "Known bad VS Code extension on a device".
//
// Runs:      Every 24 hours (30-day lookback, on purpose)
// Severity:  Medium
// MITRE:     T1176.002, T1195.001
// Tables:    DeviceFileEvents, DeviceProcessEvents
// Custom details: ExtensionId
//
// Needs:
//   - Defender for Endpoint Plan 2 on the machines your developers use.
//   - Nothing else. Defender downloads the Open VSX list itself each time the rule runs.
//
// Heads up:
//   - Skip this rule if nobody runs a fork. The Editors column in "Check your telemetry
//     first (hunt).kql" shows which editors your tenant has.
//   - It only looks at forks. Many IDs on this list are real extensions on Microsoft's
//     Marketplace, like tsandall.opa, so matching it inside VS Code would be noise.
//   - The list comes from raw.githubusercontent.com, and GitHub rate limits downloads from
//     there that aren't signed in. If the download fails, the whole run fails. Mirror the
//     file if that happens to you.
//   - This file has no blank lines, on purpose. The Defender query editor treats a blank
//     line as the end of a query and only runs the part your cursor is in.
//
// Triage (paste into Recommended actions):
//   - Check EditorFolder, Versions and Signals. Look the ID up on open-vsx.org and on
//     Microsoft's Marketplace.
//   - Remove the extension and ask the user where it came from. Escalate if the editor
//     started shells or scripts around the first event.
//   - Close if it's the real Marketplace extension sideloaded into the fork.
//
// Based on: Open VSX's extension control list from the Eclipse Foundation and VS Code's
// source. README.md has the links.
//
let Lookback = 30d;
// Editors that don't install from Microsoft's Marketplace. Add yours here.
let ForkEditors = @"(?i)^(cursor|windsurf|vscodium|codium|vscode-oss|code - oss|kiro|antigravity|trae|positron)";
// Where an extension ID shows up in a path or a command line.
let ExtensionPath = @"(?i)[\\/]\.?([^\\/]+)[\\/](?:data[\\/])?(?:extensions|CachedExtensionVSIXs)[\\/]\.?([^\\/.\s]+\.[^\\/\s]+?)-(\d+\.\d+\.\d+)";
let StoragePath = @"(?i)[\\/]\.?([^\\/]+)[\\/](?:data[\\/])?(?:User[\\/]globalStorage|User[\\/]workspaceStorage[\\/][^\\/]+|logs[\\/][^\\/]+[\\/](?:window\d+[\\/])?exthost\d*)[\\/]([^\\/.\s]+\.[^\\/\s]+)[\\/]";
let CliInstall = @"(?i)--install-extension[=\s]+\W?([a-z0-9][a-z0-9-]*\.[a-z0-9][a-z0-9-]*)";
let PathTerms = dynamic(["extensions", "CachedExtensionVSIXs", "globalStorage", "workspaceStorage", "exthost", "exthost1"]);
// Open VSX's block list. The only download in this rule.
let OpenVsxBlocked = externaldata(malicious:dynamic)
    [@"https://raw.githubusercontent.com/EclipseFdn/publish-extensions/master/extension-control/extensions.json"]
    with (format="multijson", ingestionMapping='[{"Column":"malicious","Properties":{"Path":"$.malicious"}}]')
    | mv-expand malicious to typeof(string)
    | project ExtensionId = tolower(malicious)
    | where isnotempty(ExtensionId)
    | distinct ExtensionId;
let FileEvidence = DeviceFileEvents
    | where Timestamp > ago(Lookback)
    | where FolderPath has_any (PathTerms)
    | project Timestamp, DeviceId, DeviceName, ReportId,
        AccountName = InitiatingProcessAccountName, AccountSid = InitiatingProcessAccountSid, AccountUpn = InitiatingProcessAccountUpn,
        ProcessName = InitiatingProcessFileName, Source = strcat("File ", ActionType),
        Evidence = iff(FolderPath endswith FileName, FolderPath, strcat(FolderPath, @"\", FileName));
let ProcessEvidence = DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where ProcessCommandLine has_any (PathTerms) or ProcessCommandLine has "install-extension"
        or FolderPath has_any (PathTerms) or InitiatingProcessCommandLine has_any (PathTerms)
    | project Timestamp, DeviceId, DeviceName, ReportId, AccountName, AccountSid, AccountUpn,
        ProcessName = FileName, Source = "Process",
        Evidence = strcat(FolderPath, " ", ProcessCommandLine, " ", InitiatingProcessCommandLine);
union FileEvidence, ProcessEvidence
| extend InFolder = extract(ExtensionPath, 2, Evidence), InStorage = extract(StoragePath, 2, Evidence), InCli = extract(CliInstall, 1, Evidence)
| extend ExtensionId = tolower(case(isnotempty(InFolder), InFolder, isnotempty(InStorage), InStorage, InCli))
| where isnotempty(ExtensionId)
| extend Version = extract(ExtensionPath, 3, Evidence)
| extend EditorFolder = case(
    isnotempty(InFolder), extract(ExtensionPath, 1, Evidence),
    isnotempty(InStorage), extract(StoragePath, 1, Evidence),
    ProcessName)
| where EditorFolder matches regex ForkEditors
| extend Signal = strcat(Source, ", ", case(
    isnotempty(InFolder) and Evidence has "CachedExtensionVSIXs", "VSIX cache",
    isnotempty(InFolder), "extension folder",
    isnotempty(InStorage), "storage or log folder",
    "install command"))
// One row per device and extension first. The list check below then only has that short
// table to go through.
| summarize arg_min(Timestamp, *),
        Versions = strcat_array(make_set_if(Version, isnotempty(Version)), ", "),
        Signals = strcat_array(make_set(Signal), "; ")
    by DeviceId, ExtensionId
| where ExtensionId in (OpenVsxBlocked)
| project Timestamp, DeviceId, DeviceName, ReportId, ExtensionId, Versions, EditorFolder, Signals,
    AccountName, AccountSid, AccountUpn, ProcessName, Evidence
