// Domain users or password policy listed with net
//
// Fires on "net user /domain" with no user name, which lists every account in the domain, and
// on "net accounts /domain", which shows the password and lockout rules. Checking the lockout
// threshold is what someone does before a password spray. It also catches net accounts
// changing the domain policy. Looking up one named user is left out on purpose. The helpdesk
// does that all day to check password expiry.
//
// Runs:      Continuous (NRT)
// Severity:  Medium
// MITRE:     T1087.002, T1201
// Tables:    DeviceProcessEvents
// Custom details: AccountName, InitiatingProcessFileName
//
// Needs:
//   - Nothing beyond Defender for Endpoint.
//
// Triage (paste into Recommended actions):
//   - Check the account, the device and what launched it.
//   - Escalate if it isn't a known admin, or if Summary says the policy was changed.
//   - Close if it's ticketed admin work.
//
// Based on: MITRE T1087.002 and T1201, ArgFuscator's net.exe model.

DeviceProcessEvents
| where ingestion_time() > ago(1d)
| where FileName =~ "net.exe" or FileName =~ "net1.exe" or ProcessVersionInfoOriginalFileName startswith "net.exe" or ProcessVersionInfoOriginalFileName startswith "net1.exe"
| where ProcessCommandLine matches regex @'(?i)\s"*/"*d"*o'
| where ProcessCommandLine matches regex @'(?i)^\s*(?:"[^"]*"|[^\s"]\S*\s)\s*(?:"*/\S*\s+)*(?:"*u"*s"*e"*r"*(?:s"*)?|"*a"*c"*c"*o"*u"*n"*t"*s"*)(?:\s|$)'
| where (FileName !~ "net1.exe" and ProcessVersionInfoOriginalFileName !startswith "net1.exe") or (InitiatingProcessFileName !~ "net.exe" and InitiatingProcessVersionInfoOriginalFileName !startswith "net.exe")
| extend IsPolicy = ProcessCommandLine matches regex @'(?i)^\s*(?:"[^"]*"|[^\s"]\S*\s)\s*(?:"*/\S*\s+)*"*a"*c"*c"*o"*u"*n"*t"*s"*(?:\s|$)',
         NamedUser = extract(@'(?i)^\s*(?:"[^"]*"|[^\s"]\S*\s)\s*(?:"*/\S*\s+)*"*u"*s"*e"*r"*(?:s"*)?(?:\s+"*/\S*)*\s+((?:[^\s"/]|"[^"/][^"]*")(?:[^\s"]|"[^"]*")*)', 1, ProcessCommandLine),
         ChangesPolicy = ProcessCommandLine matches regex @'(?i)\s"*/"*[a-ce-gi-z]'
| where IsPolicy or isempty(NamedUser)
| extend Summary = case(IsPolicy and ChangesPolicy, "Changed the domain password policy",
                        IsPolicy, "Read the domain password policy",
                        "Listed all domain users")
| project Timestamp, ReportId, DeviceId, DeviceName, Summary, AccountDomain, AccountName, AccountSid, FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessParentFileName
