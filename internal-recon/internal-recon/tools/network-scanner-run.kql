// Network scanner run
//
// Fires when Advanced IP Scanner, Advanced Port Scanner, SoftPerfect Network Scanner, Nmap or
// masscan runs. Elastic's rule for the first three says attackers commonly use them for
// discovery after they get in. It checks the file name and version info, plus the
// /portable /lng arguments the portable Advanced IP Scanner gets run with.
//
// Runs:      Continuous (NRT)
// Severity:  Medium
// MITRE:     T1046, T1135
// Tables:    DeviceProcessEvents
// Custom details: Scanner, AccountName
//
// Needs:
//   - Nothing beyond Defender for Endpoint.
//
// Triage (paste into Recommended actions):
//   - Check the scanner, the account, the device and the folder it ran from.
//   - Escalate if it isn't IT staff, or if it ran from a temp, Downloads or Public folder.
//   - Close if it's IT, and ask them to use an approved tool.
//
// Based on: Sigma Advanced IP Scanner, Advanced Port Scanner, SoftPerfect Netscan and Nmap
// rules, Elastic "Newly Seen Commonly Abused Network Scanner".

DeviceProcessEvents
| where ingestion_time() > ago(1d)
| extend Scanner = case(FileName contains "advanced_ip_scanner" or ProcessVersionInfoOriginalFileName contains "advanced_ip_scanner" or ProcessVersionInfoFileDescription contains "Advanced IP Scanner", "Advanced IP Scanner",
                        FileName contains "advanced_port_scanner" or ProcessVersionInfoOriginalFileName contains "advanced_port_scanner" or ProcessVersionInfoFileDescription contains "Advanced Port Scanner", "Advanced Port Scanner",
                        ProcessCommandLine contains "/portable" and ProcessCommandLine contains "/lng", "Advanced IP or Port Scanner (portable)",
                        FileName =~ "netscan.exe" or ProcessVersionInfoFileDescription =~ "Application for scanning networks", "SoftPerfect Network Scanner",
                        FileName =~ "nmap.exe" or FileName =~ "zenmap.exe" or ProcessVersionInfoOriginalFileName startswith "nmap.exe", "Nmap",
                        FileName =~ "masscan.exe", "masscan",
                        "")
| where isnotempty(Scanner)
| project Timestamp, ReportId, DeviceId, DeviceName, Scanner, AccountDomain, AccountName, AccountSid, FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessParentFileName
