// Many hosts contacted on admin ports
//
// Fires when one device reaches out to 30 or more internal hosts on SMB, RPC, RDP, WinRM or
// SSH in an hour. That's what a network scan, share hunting or SharpHound session collection
// looks like on the wire. SharpHound checks port 445 on every computer before it enumerates
// sessions. Failed connections count too.
//
// Runs:      Every hour
// Severity:  Medium
// MITRE:     T1046, T1135, T1018
// Tables:    DeviceNetworkEvents
// Custom details: Hosts, Processes
//
// Needs:
//   - Aggregated reporting turned on (Settings > Endpoints > Advanced features). Defender
//     limits how many connection events it records, and a scan is mostly repeats and failures.
//
// Heads up: vulnerability scanners, backup servers, monitoring and jump hosts do this all day.
// Put them in IgnoredDevices, short name or full name. The Defender for Identity v2.x sensor
// contacts devices on 135 and 3389 to resolve their names, so its process is left out. If
// your internal ranges aren't RFC 1918, swap the RemoteIPType line for
// ipv4_is_in_any_range(Remote, <your ranges>). A slow scan that crosses the top of the hour
// can split under the threshold.
//
// Triage (paste into Recommended actions):
//   - Check the device, the processes and the accounts.
//   - Escalate if it's a workstation, or a server with no reason to scan.
//   - Close if it's a known scanner or management server, and add it to IgnoredDevices.
//
// Tune: MinHosts, AdminPorts and IgnoredDevices at the top of the query.

let MinHosts = 30;
let AdminPorts = dynamic([22, 135, 139, 445, 3389, 5985, 5986]);
let IgnoredDevices = dynamic([]);
DeviceNetworkEvents
| where ingestion_time() > ago(2h)
| where ActionType startswith "Connection"
| where RemotePort in (AdminPorts)
| where InitiatingProcessFileName !~ "Microsoft.Tri.Sensor.exe" and InitiatingProcessFolderPath !contains "Azure Advanced Threat Protection Sensor"
| extend Remote = iff(RemoteIP startswith "::ffff:", substring(RemoteIP, 7), RemoteIP)
| where RemoteIPType == "Private" or (RemoteIPType == "FourToSixMapping" and ipv4_is_private(Remote))
| where DeviceName !in~ (IgnoredDevices) and tostring(split(DeviceName, ".")[0]) !in~ (IgnoredDevices)
| summarize Hosts = dcount(Remote), Ports = make_set(RemotePort), Processes = make_set(InitiatingProcessFileName, 10), Accounts = make_set(InitiatingProcessAccountName, 10),
            SampleHosts = make_set(Remote, 15), FirstSeen = min(Timestamp), LastSeen = max(Timestamp), (Timestamp, ReportId) = arg_max(Timestamp, ReportId)
            by DeviceId, DeviceName, Hour = bin(Timestamp, 1h)
| where Hosts >= MinHosts
| project Timestamp, ReportId, DeviceId, DeviceName, Hosts, Ports, Processes, Accounts, FirstSeen, LastSeen, SampleHosts
