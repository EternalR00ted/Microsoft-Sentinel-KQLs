// Recon command burst
//
// Fires when one account on one device runs 4 or more different recon tools in one sitting.
// A sitting ends after 15 quiet minutes or an hour total. whoami, ipconfig, systeminfo,
// net user, net group and nltest back to back is what hands-on-keyboard recon looks like.
// Each net subcommand counts as its own tool. net use and net time don't count, because
// logon scripts run them all day.
//
// Runs:      Every hour
// Severity:  Medium
// MITRE:     T1033, T1082, T1016, T1049, T1057, T1069, T1087, T1135, T1482
// Tables:    DeviceProcessEvents
// Custom details: Tools, Launchers
//
// Needs:
//   - Nothing beyond Defender for Endpoint.
//
// Heads up: MsSense.exe and SenseIR.exe are Defender's own processes, so they're ignored as
// launchers. Intune scripts run through AgentExecutor.exe. If an inventory script trips this,
// add AgentExecutor.exe to IgnoredLaunchers, but know that anyone with Intune admin then gets
// the same pass.
//
// Triage (paste into Recommended actions):
//   - Check the tools, the sample commands and what launched them.
//   - Escalate if it isn't an admin troubleshooting, or if a launcher is a web server, Office,
//     a script host, wmiprvse or something in a user or temp folder.
//   - Close if it's ticketed troubleshooting.
//
// Tune: MinTools and IgnoredLaunchers at the top of the query.

let MinTools = 4;
let IgnoredLaunchers = dynamic(["MsSense.exe", "SenseIR.exe"]);
let ReconTools = datatable(Image:string, Tool:string) [
    "whoami.exe", "whoami",
    "hostname.exe", "hostname",
    "systeminfo.exe", "systeminfo",
    "sysinfo.exe", "systeminfo",
    "ipconfig.exe", "ipconfig",
    "arp.exe", "arp",
    "route.exe", "route",
    "netstat.exe", "netstat",
    "nbtstat.exe", "nbtstat",
    "tasklist.exe", "tasklist",
    "nslookup.exe", "nslookup",
    "nltest.exe", "nltest",
    "nltestrk.exe", "nltest",
    "dsquery.exe", "dsquery",
    "wmic.exe", "wmic",
    "cmdkey.exe", "cmdkey",
    "klist.exe", "klist",
    "setspn.exe", "setspn",
    "gpresult.exe", "gpresult",
    "gprslt.exe", "gpresult",
    "quser.exe", "query user",
    "qwinsta.exe", "query session",
    "qprocess.exe", "query process",
    "query.exe", "query",
    "net.exe", "net",
    "net1.exe", "net"
];
DeviceProcessEvents
| where ingestion_time() > ago(2h)
| where InitiatingProcessFileName !in~ (IgnoredLaunchers) and InitiatingProcessParentFileName !in~ (IgnoredLaunchers)
| extend Exe = tolower(FileName), Ofn = tolower(ProcessVersionInfoOriginalFileName)
| extend Ofn = iff(Ofn endswith ".mui", substring(Ofn, 0, strlen(Ofn) - 4), Ofn)
| extend Image = iff(Exe in ("whoami.exe", "hostname.exe", "systeminfo.exe", "sysinfo.exe", "ipconfig.exe", "arp.exe", "route.exe", "netstat.exe", "nbtstat.exe", "tasklist.exe", "nslookup.exe", "nltest.exe", "nltestrk.exe", "dsquery.exe", "wmic.exe", "cmdkey.exe", "klist.exe", "setspn.exe", "gpresult.exe", "gprslt.exe", "quser.exe", "qwinsta.exe", "qprocess.exe", "query.exe", "net.exe", "net1.exe"), Exe, Ofn)
| lookup kind=inner ReconTools on Image
| where not((Exe == "net1.exe" or Ofn == "net1.exe") and (InitiatingProcessFileName =~ "net.exe" or InitiatingProcessVersionInfoOriginalFileName startswith "net.exe"))
| extend FirstArg = tolower(replace_string(extract(@'(?i)^\s*(?:"[^"]*"|[^\s"]\S*\s)\s*(?:"*/\S*\s+)*("*[a-z][a-z"]*)', 1, ProcessCommandLine), '"', ''))
| extend Tool = case(Tool == "net", case(FirstArg == "user", "net user", FirstArg == "users", "net user", FirstArg == "group", "net group", FirstArg == "groups", "net group", FirstArg == "localgroup", "net localgroup", FirstArg == "view", "net view", FirstArg == "share", "net share", FirstArg == "session", "net session", FirstArg == "sessions", "net session", FirstArg == "sess", "net session", FirstArg == "accounts", "net accounts", FirstArg == "config", "net config", ""),
                     Tool == "query", case(FirstArg == "user", "query user", FirstArg == "session", "query session", FirstArg == "process", "query process", FirstArg == "termserver", "query termserver", ""),
                     Tool)
| where isnotempty(Tool)
| sort by DeviceId asc, AccountSid asc, Timestamp asc
| extend Sitting = row_window_session(Timestamp, 1h, 15m, DeviceId != prev(DeviceId) or AccountSid != prev(AccountSid))
| summarize Tools = make_set(Tool), Launchers = make_set(InitiatingProcessFileName, 10), SampleCommands = make_set(substring(ProcessCommandLine, 0, 200), 15),
            FirstSeen = min(Timestamp), LastSeen = max(Timestamp), (Timestamp, ReportId) = arg_max(Timestamp, ReportId)
            by DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, Sitting
| extend ToolCount = array_length(Tools)
| where ToolCount >= MinTools
| project Timestamp, ReportId, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, ToolCount, Tools, Launchers, FirstSeen, LastSeen, SampleCommands
