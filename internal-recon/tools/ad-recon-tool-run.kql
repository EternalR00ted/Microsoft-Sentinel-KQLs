// AD recon tool run
//
// Fires when AdFind, SharpHound, PingCastle or an ADExplorer snapshot runs. Each one pulls
// most of Active Directory in one go. MITRE lists Play, Akira, BlackByte, INC Ransom and
// Wizard Spider all using AdFind. It checks the file name, the version info and tool-specific
// arguments, so renamed copies still match. That includes AdFind shortcuts typed with the
// Unicode dashes ArgFuscator found AdFind accepts.
//
// Runs:      Continuous (NRT)
// Severity:  High
// MITRE:     T1087.002, T1069.002, T1482, T1018
// Tables:    DeviceProcessEvents
// Custom details: Tool, AccountName
//
// Needs:
//   - Nothing beyond Defender for Endpoint.
//
// Heads up: PingCastle is a real AD health check tool. If your team runs it, exclude their
// accounts and devices. Same for a BloodHound Enterprise collector server, which runs
// SharpHound as a service. A shell that wraps AdFind or SharpHound isn't counted, so a batch
// file doesn't double the alert.
//
// Triage (paste into Recommended actions):
//   - Check the tool, the account, the device and the folder it ran from.
//   - Escalate unless it's an approved audit or pentest.
//   - Close if it's approved, and note the ticket.
//
// Based on: Sigma AdFind, ADExplorer, SharpHound and PingCastle rules, SharpHound's source,
// ArgFuscator's adfind.exe model, MITRE S0552.

DeviceProcessEvents
| where ingestion_time() > ago(1d)
| extend Tool = case(FileName =~ "adfind.exe" or ProcessVersionInfoOriginalFileName startswith "AdFind.exe", "AdFind",
                     FileName !~ "cmd.exe" and FileName !~ "powershell.exe" and FileName !~ "pwsh.exe" and ProcessCommandLine matches regex @'(?i)(?:^|\s)"*[-/\x{2010}\x{2012}\x{2013}\x{2015}\x{2044}\x{2212}\x{2215}\x{FF0D}]"*s"*c"*\s+"*(?:t"*r"*u"*s"*t"*d"*m"*p|d"*c"*m"*o"*d"*e"*s|a"*d"*i"*n"*f"*o|d"*c"*l"*i"*s"*t|d"*o"*m"*a"*i"*n"*l"*i"*s"*t|c"*o"*m"*p"*u"*t"*e"*r"*s"*_"*p"*w"*d"*n"*o"*t"*r"*e"*q"*d|c"*o"*m"*p"*u"*t"*e"*r"*s"*_"*a"*c"*t"*i"*v"*e|u"*s"*e"*r"*s"*_"*n"*o"*e"*x"*p"*i"*r"*e|a"*d"*m"*i"*n"*c"*o"*u"*n"*t"*d"*m"*p|e"*x"*c"*h"*a"*d"*d"*r"*e"*s"*s"*e"*s|d"*o"*m"*p"*o"*l|o"*u"*d"*m"*p|s"*u"*b"*n"*e"*t"*d"*m"*p|g"*p"*o"*d"*m"*p|f"*s"*p"*d"*m"*p|d"*o"*m"*a"*i"*n"*n"*c"*s|u"*:)|(?:^|\s)"*[-/\x{2010}\x{2012}\x{2013}\x{2015}\x{2044}\x{2212}\x{2215}\x{FF0D}]"*f"*\s+"*\(?"*o"*b"*j"*e"*c"*t"*c"*a"*t"*e"*g"*o"*r"*y"*=|(?:^|\s)"*[-/\x{2010}\x{2012}\x{2013}\x{2015}\x{2044}\x{2212}\x{2215}\x{FF0D}]"*s"*u"*b"*n"*e"*t"*s"*\s+"*[-/\x{2010}\x{2012}\x{2013}\x{2015}\x{2044}\x{2212}\x{2215}\x{FF0D}]"*f(?:\s|$)', "AdFind (renamed)",
                     (FileName matches regex @'(?i)^adexp(?:lorer(?:64a?)?)?\.exe$' or ProcessVersionInfoOriginalFileName startswith "AdExp" or ProcessVersionInfoProductName =~ "Sysinternals ADExplorer") and ProcessCommandLine contains "snapshot", "ADExplorer snapshot",
                     FileName =~ "SharpHound.exe" or ProcessVersionInfoOriginalFileName startswith "SharpHound.exe" or ProcessVersionInfoProductName =~ "SharpHound" or ProcessVersionInfoCompanyName =~ "SpecterOps" or (FileName !~ "cmd.exe" and ProcessCommandLine matches regex @'(?i)--(?:collectionmethods|randomfilenames|dolocaladminsessionenum|skipregistryloggedon|excludedcs|loopduration|collectallproperties|trackcomputercalls|searchforest|zipfilename)\b|invoke-bloodhound'), "SharpHound",
                     FileName =~ "PingCastle.exe" or ProcessVersionInfoOriginalFileName startswith "PingCastle.exe" or ProcessVersionInfoProductName =~ "Ping Castle", "PingCastle",
                     "")
| where isnotempty(Tool)
| project Timestamp, ReportId, DeviceId, DeviceName, Tool, AccountDomain, AccountName, AccountSid, FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessParentFileName
