// Net group command used
//
// Fires when someone runs "net group". That covers listing domain groups, listing who's in
// one, and adding or removing members. It also catches net1.exe run directly, renamed copies,
// and the tricks ArgFuscator lists for net.exe: random case, quotes inside words and short
// switches like /dom. net.exe hands the command to a net1.exe child, so that copy is dropped
// and one command makes one event.
//
// Runs:      Continuous (NRT)
// Severity:  Medium
// MITRE:     T1069.002
// Tables:    DeviceProcessEvents
// Custom details: AccountName, InitiatingProcessFileName
//
// Needs:
//   - Nothing beyond Defender for Endpoint.
//
// Heads up: on a workstation, net group without /domain just errors out. If UsedDomainSwitch
// is false on a workstation, it was probably a failed try.
//
// Triage (paste into Recommended actions):
//   - Check the account, the device and what launched it.
//   - Escalate if it isn't a known admin on an admin box, if the launcher is Office, a
//     browser, a script host or wmiprvse, or if a member was added to a sensitive group.
//   - Close if it's ticketed admin work.
//
// Tune: to page on adds to admin groups by themselves, save a copy with
// | where Activity == "Add member" and SensitiveGroup on the end, set it to High and map
// T1098.007.
//
// Based on: MITRE T1069.002, ArgFuscator's net.exe model, JPCERT's net command analysis.

DeviceProcessEvents
| where ingestion_time() > ago(1d)
| where FileName =~ "net.exe" or FileName =~ "net1.exe" or ProcessVersionInfoOriginalFileName startswith "net.exe" or ProcessVersionInfoOriginalFileName startswith "net1.exe"
| where ProcessCommandLine matches regex @'(?i)^\s*(?:"[^"]*"|[^\s"]\S*\s)\s*(?:"*/\S*\s+)*"*g"*r"*o"*u"*p"*(?:s"*)?(?:\s|$)'
| where (FileName !~ "net1.exe" and ProcessVersionInfoOriginalFileName !startswith "net1.exe") or (InitiatingProcessFileName !~ "net.exe" and InitiatingProcessVersionInfoOriginalFileName !startswith "net.exe")
| extend GroupRaw = extract(@'(?i)^\s*(?:"[^"]*"|[^\s"]\S*\s)\s*(?:"*/\S*\s+)*"*g"*r"*o"*u"*p"*(?:s"*)?(?:\s+"*/\S*)*\s+((?:[^\s"/]|"[^"/][^"]*")(?:[^\s"]|"[^"]*")*)', 1, ProcessCommandLine),
         MemberRaw = extract(@'(?i)^\s*(?:"[^"]*"|[^\s"]\S*\s)\s*(?:"*/\S*\s+)*"*g"*r"*o"*u"*p"*(?:s"*)?(?:\s+"*/\S*)*\s+(?:[^\s"/]|"[^"/][^"]*")(?:[^\s"]|"[^"]*")*(?:\s+"*/\S*)*\s+((?:[^\s"/]|"[^"/][^"]*")(?:[^\s"]|"[^"]*")*)', 1, ProcessCommandLine),
         IsAdd = ProcessCommandLine matches regex @'(?i)\s"*/"*a',
         IsDelete = ProcessCommandLine matches regex @'(?i)\s"*/"*d"*e',
         UsedDomainSwitch = ProcessCommandLine matches regex @'(?i)\s"*/"*d"*o'
| extend TargetGroup = iif(GroupRaw matches regex @'^"[^"]*"$', extract(@'^"([^"]*)"$', 1, GroupRaw), GroupRaw),
         Member = iif(MemberRaw matches regex @'^"[^"]*"$', extract(@'^"([^"]*)"$', 1, MemberRaw), MemberRaw)
| extend Activity = case(IsAdd and isnotempty(Member), "Add member",
                         IsDelete and isnotempty(Member), "Remove member",
                         IsAdd and isnotempty(TargetGroup), "Create group",
                         IsDelete and isnotempty(TargetGroup), "Delete group",
                         isnotempty(TargetGroup), "List members",
                         "List all groups"),
         SensitiveGroup = TargetGroup matches regex @'(?i)admins?\b|administrators|administrateurs|operators|opérateurs|domain controllers|group policy creator owners|exchange trusted subsystem|exchange windows permissions|organization management'
| extend Summary = case(Activity == "Add member", strcat("Added ", Member, " to ", TargetGroup),
                        Activity == "Remove member", strcat("Removed ", Member, " from ", TargetGroup),
                        Activity == "Create group", strcat("Created group ", TargetGroup),
                        Activity == "Delete group", strcat("Deleted group ", TargetGroup),
                        Activity == "List members", strcat("Looked up members of ", TargetGroup),
                        "Listed all groups")
| project Timestamp, ReportId, DeviceId, DeviceName, Summary, Activity, TargetGroup, Member, SensitiveGroup, UsedDomainSwitch, AccountDomain, AccountName, AccountSid, FileName, FolderPath, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessParentFileName
