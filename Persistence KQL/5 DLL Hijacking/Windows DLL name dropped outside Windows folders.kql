DeviceFileEvents
| where ActionType startswith "FileCreated" or ActionType startswith "FileRenamed" or ActionType startswith "FileModified"
| where FileName endswith ".dll"
| extend DllName = tolower(FileName)
| where DllName in ("version.dll", "cryptbase.dll", "netutils.dll", "sspicli.dll", "logoncli.dll", "userenv.dll", "propsys.dll", "iphlpapi.dll", "srvcli.dll", "winsta.dll", "uxtheme.dll", "devobj.dll", "samcli.dll", "dnsapi.dll", "bcd.dll", "winhttp.dll", "mpr.dll", "dui70.dll", "ntdsapi.dll", "wtsapi32.dll", "dsrole.dll", "netapi32.dll", "wininet.dll", "credui.dll", "dwmapi.dll", "dwrite.dll", "secur32.dll", "wkscli.dll", "vssapi.dll", "fltlib.dll", "profapi.dll", "oleacc.dll", "wevtapi.dll", "duser.dll", "edputil.dll", "wer.dll", "winmm.dll", "cryptsp.dll", "ncrypt.dll", "ktmw32.dll", "activeds.dll", "urlmon.dll", "msi.dll", "umpdc.dll", "policymanager.dll", "iertutil.dll", "xmllite.dll", "mpclient.dll", "mpsvc.dll")
| extend LowerPath = tolower(FolderPath), Writer = tolower(InitiatingProcessFileName), WriterPath = tolower(InitiatingProcessFolderPath), IsSystem = InitiatingProcessAccountSid == "S-1-5-18"
| extend InWindowsHome = LowerPath matches regex @"^c:\\windows\\(system32|syswow64|winsxs|servicing|softwaredistribution|systemapps|immersivecontrolpanel)(\\|$)"
| extend InWritableWindowsFolder = LowerPath matches regex @"^c:\\windows\\(system32|syswow64)\\(fxstmp|com\\dmp|microsoft\\crypto\\rsa\\machinekeys|spool\\(printers|servers|drivers\\color)|tasks|tasks_migrated)(\\|$)"
| extend InKitFolder = LowerPath matches regex @"^c:\\program files( \(x86\))?\\(windows kits|microsoft office\\root\\vfs)\\"
| extend InUpgradeFolder = IsSystem and LowerPath matches regex @"^c:\\(\$windows\.~bt|\$windows\.~ws|\$winreagent|windows\.old)(\\|$)"
| extend InDefenderHome = DllName in ("mpclient.dll", "mpsvc.dll") and LowerPath matches regex @"^c:\\(program files( \(x86\))?\\windows defender|programdata\\microsoft\\windows defender\\platform)(\\|$)"
| extend IsServicing = IsSystem and ((Writer in ("tiworker.exe", "poqexec.exe") and WriterPath matches regex @"^c:\\windows\\(winsxs\\[^\\]+|system32)(\\[^\\]+\.exe)?$") or (Writer == "trustedinstaller.exe" and WriterPath matches regex @"^c:\\windows\\servicing(\\[^\\]+\.exe)?$") or (Writer in ("dism.exe", "mousocoreworker.exe") and WriterPath matches regex @"^c:\\windows\\(system32|syswow64)(\\[^\\]+\.exe)?$") or (Writer == "dismhost.exe" and WriterPath matches regex @"^c:\\windows\\temp\\\{[0-9a-f-]+\}(\\[^\\]+\.exe)?$") or (Writer in ("setuphost.exe", "setupplatform.exe") and WriterPath matches regex @"^c:\\\$windows\.~bt\\sources(\\[^\\]+\.exe)?$"))
| where (InWindowsHome == false or InWritableWindowsFolder) and InKitFolder == false and InUpgradeFolder == false and InDefenderHome == false and IsServicing == false
| extend Reason = iif(InWritableWindowsFolder, strcat("Windows DLL name written to a user-writable Windows folder: ", FileName), strcat("Windows DLL name written outside Windows folders: ", FileName))
| project Timestamp, DeviceId, DeviceName, ReportId, ActionType, Reason, FileName, FolderPath, SHA1, FileOriginUrl, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, InitiatingProcessSHA1, InitiatingProcessAccountName, InitiatingProcessAccountSid, InitiatingProcessAccountUpn, InitiatingProcessAccountObjectId
