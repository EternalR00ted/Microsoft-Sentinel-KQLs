// App assigned an admin role
// Alert title: <Company> - Entra ID - {{AssignedBy}} assigned {{RoleName}} to {{TargetName}}
//
// What it catches
//   An application (not a person) assigning an Entra role to itself or to anyone else, and any privileged role landing
//   on a service principal no matter who assigned it. On Oct 15, 2026 the ConnectWise Cloud Management - MS Teams app
//   added itself to Global Administrator at 03:44 and again at 03:48 UTC, then planted secrets on two other apps in the
//   same five minutes (Huntress). In about 50 other tenants that morning, ConnectWise apps gave themselves directory
//   roles, mostly Exchange Administrator (Huntress). Microsoft's built-in alert only covers an app self-assigning
//   Global Administrator. This covers every role and assignments to others.
//
// PIM activations show up as "Add member to role" initiated by MS-PIM. Those are excluded.
// Failed attempts are kept. A failed self-assignment is still an app trying to escalate.
// The User-Agent comes from AdditionalDetails. Huntress used it to tell vendor automation (kiota-dotnet) from the
// attacker's script (Python-urllib/3.12).
//
// Tables: AuditLogs
// Run: every 5 minutes with Window = 5m if you can, otherwise hourly with Window = 1h. Severity: Severity column.
// MITRE: T1098.003 Account Manipulation: Additional Cloud Roles
// Entities: Account (AadUserId) = InitiatorServicePrincipalId and TargetId, OAuth application = InitiatorAppId
let Window = 1h;
let ApprovedRoleAutomation = dynamic([]);  // display names of your own automation that assigns roles, once you've confirmed it
let PrivilegedRoleTemplateIds = dynamic([
    "62e90394-69f5-4237-9190-012177145e10", // Global Administrator
    "e8611ab8-c189-46e8-94e1-60213ab1f814", // Privileged Role Administrator
    "7be44c8a-adaf-4e2a-84d6-ab2649e08a13", // Privileged Authentication Administrator
    "9b895d92-2cd3-44c7-9d02-a6ac2d5ea5c3", // Application Administrator
    "158c047a-c907-4556-b7ef-446551a6b5f7", // Cloud Application Administrator
    "29232cdf-9323-42fd-ade2-1d097af3e4de", // Exchange Administrator
    "f28a1f50-f6e7-4571-818b-6a12f2af6b6c", // SharePoint Administrator
    "69091246-20e8-4a56-aa4d-066075b2a7a8", // Teams Administrator
    "fe930be7-5e62-47db-91af-98c3a49a38b1", // User Administrator
    "c4e39bd9-1100-46d3-8c65-fb160da0071f", // Authentication Administrator
    "0526716b-113d-4c15-b2c8-68e3c22b9f80", // Authentication Policy Administrator
    "194ae4cb-b126-40b2-bd5b-6091b380977d", // Security Administrator
    "b1be1c3e-b65d-4f19-8427-f6fa0d97feb9", // Conditional Access Administrator
    "8ac3fc64-6eca-42ea-9e69-59f4c7b60eb2", // Hybrid Identity Administrator
    "be2f45a1-457d-42af-a067-6ec1fa63bc45", // External Identity Provider Administrator
    "8329153b-31d0-4727-b945-745eb3bc5f31", // Domain Name Administrator
    "3a2c62db-5318-420d-8d74-23affee5d9d5", // Intune Administrator
    "7698a772-787b-4ac8-901f-60d6b08affd2", // Cloud Device Administrator
    "9f06204d-73c1-4d4c-880a-6edb90606fd8", // Microsoft Entra Joined Device Local Administrator
    "fdd7a751-b60b-444a-984c-02652fe8fa1c", // Groups Administrator
    "729827e3-9c14-49f7-bb1b-9608f156bbb8", // Helpdesk Administrator
    "9360feb5-f418-4baa-8175-e2a00bac4301", // Directory Writers
    "d29b2b05-8046-44ba-8758-1e26182fcf32", // Directory Synchronization Accounts
    "e00e864a-17c5-4a4b-9c06-f5b95a8d5bd8", // Partner Tier2 Support
    "f2ef992c-3afb-46b9-b7cf-a126ee74c451"  // Global Reader (read only, but it's what an attacker wants for recon)
]);
let PrivilegedRoleNames = dynamic([
    "Global Administrator", "Company Administrator", "Privileged Role Administrator", "Privileged Authentication Administrator",
    "Application Administrator", "Cloud Application Administrator", "Exchange Administrator", "SharePoint Administrator",
    "Teams Administrator", "User Administrator", "Authentication Administrator", "Authentication Policy Administrator",
    "Security Administrator", "Conditional Access Administrator", "Hybrid Identity Administrator",
    "External Identity Provider Administrator", "Domain Name Administrator", "Intune Administrator",
    "Cloud Device Administrator", "Microsoft Entra Joined Device Local Administrator", "Groups Administrator",
    "Helpdesk Administrator", "Directory Writers", "Directory Synchronization Accounts", "Partner Tier2 Support", "Global Reader"
]);
AuditLogs
| where ingestion_time() > ago(Window)
| where Category =~ "RoleManagement"
| where OperationName in~ ("Add member to role", "Add eligible member to role", "Add scoped member to role", "Add member to role outside of PIM")
| extend
    InitiatorAppId = tostring(InitiatedBy.app.appId),
    InitiatorServicePrincipalId = tostring(InitiatedBy.app.servicePrincipalId),
    InitiatorApp = tostring(InitiatedBy.app.displayName),
    InitiatorUserId = tostring(InitiatedBy.user.id),
    InitiatorUpn = tostring(InitiatedBy.user.userPrincipalName)
| extend InitiatedByApp = (isnotempty(InitiatorServicePrincipalId) or isnotempty(InitiatorAppId)) and isempty(InitiatorUserId)
| where not(InitiatorApp in~ ("MS-PIM", "MS-PIM-Fairfax") or Identity in~ ("MS-PIM", "MS-PIM-Fairfax"))
| where not(InitiatorApp in~ (ApprovedRoleAutomation))
// The principal that received the role is the first target, same as Microsoft's own role assignment rules
| extend
    TargetType = tostring(TargetResources[0].type),
    TargetId = tostring(TargetResources[0].id),
    TargetName = coalesce(tostring(TargetResources[0].userPrincipalName), tostring(TargetResources[0].displayName)),
    RoleBlob = tostring(TargetResources)
// mv-apply drops a row when the array is empty, so give empty arrays one placeholder element
| extend
    TargetsToRead = iff(array_length(TargetResources) > 0, TargetResources, dynamic([{"modifiedProperties": []}])),
    DetailsToRead = iff(array_length(AdditionalDetails) > 0, AdditionalDetails, dynamic([{"key": "none", "value": ""}]))
// The role itself. Classic role assignments log Role.*, the roleAssignments API logs RoleDefinition.*
| mv-apply Target = TargetsToRead on (
    mv-expand Prop = Target.modifiedProperties
    | summarize
        RoleName = take_anyif(trim(@'[\"\s]+', tostring(Prop.newValue)), tostring(Prop.displayName) in ("Role.DisplayName", "RoleDefinition.DisplayName")),
        RoleTemplateId = take_anyif(trim(@'[\"\s]+', tostring(Prop.newValue)), tostring(Prop.displayName) in ("Role.TemplateId", "RoleDefinition.TemplateId"))
    )
| mv-apply Detail = DetailsToRead on (
    summarize UserAgent = take_anyif(tostring(Detail.value), tostring(Detail.key) =~ "User-Agent")
    )
| extend IsPrivilegedRole = tolower(RoleTemplateId) in (PrivilegedRoleTemplateIds) or RoleName in~ (PrivilegedRoleNames) or RoleBlob has_any (PrivilegedRoleTemplateIds)
| extend SelfAssigned = InitiatedByApp and isnotempty(TargetId) and TargetId == InitiatorServicePrincipalId
| where InitiatedByApp or (TargetType =~ "ServicePrincipal" and IsPrivilegedRole)
| extend Severity = case(
    InitiatedByApp and (SelfAssigned or IsPrivilegedRole), "High",
    InitiatedByApp, "Medium",
    "Medium")
| extend AssignedBy = coalesce(InitiatorApp, InitiatorUpn, InitiatorAppId)
| project
    TimeGenerated,
    Severity,
    AssignedBy,
    OperationName,
    Result,
    ResultReason,
    RoleName,
    RoleTemplateId,
    IsPrivilegedRole,
    SelfAssigned,
    InitiatedByApp,
    InitiatorApp,
    InitiatorAppId,
    InitiatorServicePrincipalId,
    InitiatorUpn,
    TargetType,
    TargetName,
    TargetId,
    UserAgent,
    CorrelationId
| order by TimeGenerated asc
