// Planted app credential used to sign in
// Alert title: <Company> - Entra ID - Secret planted by {{AddedByApp}} was used to sign in as {{ServicePrincipalName}}
//
// What it catches
//   A service principal signing in with a secret or certificate that another application added in the last 7 days.
//   Rule 6 fires when the credential is planted. This one fires when somebody comes back and uses it, and it ties the
//   sign-in to the exact key through the key ID. Huntress found a secret the ConnectWise Teams app planted on the
//   Huntress app in one tenant, and it was used to sign in seven times in quick succession (Huntress). Rotating the
//   vendor's credential doesn't touch a planted one (Microsoft, Huntress).
//
// The join is on the credential's key ID: KeyIdentifier in the audit event's KeyDescription, and
// ServicePrincipalCredentialKeyId in the sign-in log ("the unique identifier of the key credential used", Graph docs).
// Check the SecretSignInsWithKeyId column in "Check log sources first". If it's 0 while SecretSignIns isn't, your
// tenant logs secret sign-ins without a key ID and this rule only covers certificates. Rule 2 still sees the sign-in.
//
// Tables: AuditLogs, AADServicePrincipalSignInLogs
// Run: every hour, look back 7 days. Severity: High.
// MITRE: T1098.001 Account Manipulation: Additional Cloud Credentials, T1078.004 Valid Accounts: Cloud Accounts
// Entities: OAuth application = AppId, Account (AadUserId) = ServicePrincipalId, IP = IPAddresses
let Lookback = 7d;
let Window = 1h;
let ApprovedCredentialAutomation = dynamic([]);  // keep in sync with rule 06: your own secret-rotation automation
let PlantedKeys = AuditLogs
    | where TimeGenerated > ago(Lookback)
    | where OperationName has_any ("Certificates and secrets management", "Add service principal credentials")
    | where Result =~ "success"
    | extend
        AddedByAppId = tostring(InitiatedBy.app.appId),
        AddedBySpId = tostring(InitiatedBy.app.servicePrincipalId),
        AddedByApp = tostring(InitiatedBy.app.displayName),
        InitiatorUserId = tostring(InitiatedBy.user.id)
    | where (isnotempty(AddedBySpId) or isnotempty(AddedByAppId)) and isempty(InitiatorUserId)
    | where not(AddedByApp in~ (ApprovedCredentialAutomation))
    | mv-expand Target = TargetResources
    | mv-expand Prop = Target.modifiedProperties
    | where tostring(Prop.displayName) == "KeyDescription"
    | extend
        NewKeyList = iff(isempty(tostring(Prop.newValue)), dynamic([]), todynamic(tostring(Prop.newValue))),
        OldKeyList = iff(isempty(tostring(Prop.oldValue)), dynamic([]), todynamic(tostring(Prop.oldValue)))
    | mv-expand AddedKey = set_difference(NewKeyList, OldKeyList) to typeof(string)
    | extend KeyId = tolower(extract(@"KeyIdentifier=([0-9a-fA-F-]{36})", 1, AddedKey))
    | where isnotempty(KeyId)
    | project
        KeyAddedAt = TimeGenerated,
        KeyId,
        KeyDetails = AddedKey,
        PlantedOn = tostring(Target.displayName),
        PlantedOnType = tostring(Target.type),
        AddedByApp,
        AddedByAppId,
        AddedBySpId,
        AddCorrelationId = CorrelationId;
AADServicePrincipalSignInLogs
| where ingestion_time() > ago(Window)
| where isnotempty(ServicePrincipalCredentialKeyId)
| extend KeyId = tolower(ServicePrincipalCredentialKeyId)
| join kind = inner PlantedKeys on KeyId
| where TimeGenerated >= KeyAddedAt
| summarize
    FirstUse = min(TimeGenerated),
    LastUse = max(TimeGenerated),
    SignIns = count(),
    Successes = countif(ResultType == "0"),
    IPAddresses = make_set(IPAddress, 20),
    ASNs = make_set(AutonomousSystemNumber, 10),
    UserAgents = make_set(UserAgent, 10),
    Resources = make_set(ResourceDisplayName, 20)
    by AppId, ServicePrincipalName, ServicePrincipalId, KeyId, KeyAddedAt, KeyDetails, PlantedOn, PlantedOnType, AddedByApp, AddedByAppId, AddedBySpId, AddCorrelationId
| extend MinutesFromPlantToUse = datetime_diff('minute', FirstUse, KeyAddedAt)
| project
    TimeGenerated = LastUse,
    ServicePrincipalName,
    AppId,
    ServicePrincipalId,
    AddedByApp,
    AddedByAppId,
    KeyAddedAt,
    FirstUse,
    MinutesFromPlantToUse,
    SignIns,
    Successes,
    IPAddresses,
    ASNs,
    UserAgents,
    Resources,
    KeyId,
    KeyDetails,
    PlantedOn,
    PlantedOnType,
    AddCorrelationId
