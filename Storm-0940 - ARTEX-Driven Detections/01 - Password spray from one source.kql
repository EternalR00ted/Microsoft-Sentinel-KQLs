// Password spray from one source
// Alert title: <Company> - Entra ID - Password spray from {{IPAddress}}
//
// What it catches
//   One IP failing sign-ins across many accounts (broad spray), or pounding a few accounts until smart lockout
//   kicks in (focused spray). Storm-0940 did both from one IP between Oct 10 and 14, 2026: 151,000+ failures,
//   2,900 a minute at the peak, and about 98% of the responses were lockouts (Microsoft). Huntress saw the same
//   hosting range send scripted OAuth token requests with curl and try client app IDs that belong to other tools.
//   No IP or user agent lists. The volume and shape of the failures is the signal.
//
// PasswordWorkedFor lists accounts where this IP got a result Entra only returns after the password was accepted
// (success, MFA required, CA block, expired password). Treat any name in that list as a confirmed password.
//
// Tables: SigninLogs, AADNonInteractiveUserSignInLogs
// Run: every hour, look back 1 hour (Window must match how often it runs).
// Severity: Medium, High when PasswordWorkedFor isn't empty (Severity column).
// MITRE: T1110.003 Password Spraying, T1110.001 Password Guessing
// Entities: IP = IPAddress
let Window = 1h;
let MinAccounts = 10;    // broad spray: distinct accounts that failed from one IP in the window
let MinFailures = 100;   // focused spray: failures from one IP in the window, even against a handful of accounts
let FailureCodes = dynamic(["50126", "50053", "50034", "50056", "50057", "50064"]);
let PasswordWorkedCodes = dynamic(["0", "50055", "50072", "50074", "50076", "50079", "50105", "50158", "53000", "53001", "53003"]);
union isfuzzy = true
    (SigninLogs | where ingestion_time() > ago(Window)),
    (AADNonInteractiveUserSignInLogs | where ingestion_time() > ago(Window))
| where isnotempty(IPAddress)
| where ResultType in (FailureCodes) or ResultType in (PasswordWorkedCodes)
| extend Account = tolower(UserPrincipalName)
| summarize
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    Failures = countif(ResultType in (FailureCodes)),
    Lockouts = countif(ResultType == "50053"),
    UnknownAccountFailures = countif(ResultType == "50034"),
    AccountsFailed = dcountif(Account, ResultType in (FailureCodes)),
    AccountsPasswordWorked = dcountif(Account, ResultType in (PasswordWorkedCodes)),
    PasswordWorkedFor = make_set_if(Account, ResultType in (PasswordWorkedCodes), 20),
    SampleTargets = make_set_if(Account, ResultType in (FailureCodes), 25),
    ClientAppIdsTried = dcount(AppId),
    Protocols = make_set(AuthenticationProtocol, 10),
    UserAgents = make_set(UserAgent, 10),
    ASN = take_any(AutonomousSystemNumber),
    Countries = make_set(Location, 5)
    by IPAddress
| where AccountsFailed >= MinAccounts or Failures >= MinFailures
// Shared egress (an office or VPN) has more accounts signing in fine than failing. A spray source doesn't.
| where AccountsPasswordWorked < AccountsFailed
| extend MinutesActive = max_of(1.0, datetime_diff('second', LastSeen, FirstSeen) / 60.0)
| extend
    FailuresPerMinute = round(Failures / MinutesActive, 1),
    LockoutPercent = round(100.0 * Lockouts / Failures, 1),
    Severity = iff(array_length(PasswordWorkedFor) > 0, "High", "Medium")
| project
    TimeGenerated = LastSeen,
    IPAddress,
    ASN,
    Countries,
    Severity,
    AccountsFailed,
    Failures,
    FailuresPerMinute,
    LockoutPercent,
    UnknownAccountFailures,
    PasswordWorkedFor,
    ClientAppIdsTried,
    Protocols,
    UserAgents,
    SampleTargets,
    FirstSeen,
    LastSeen
| order by Failures desc
