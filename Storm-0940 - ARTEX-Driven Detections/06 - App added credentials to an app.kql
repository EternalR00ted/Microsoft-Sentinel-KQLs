// App added credentials to an app
// Alert title: <Company> - Entra ID - {{AddedBy}} added a credential to {{TargetName}}
//
// What it catches
//   An application adding a client secret or certificate to an app registration or service principal, including
//   failed attempts, plus anyone adding a sign-in credential directly to a service principal object. On Oct 15, 2026
//   the ConnectWise Teams app made nine changes to two other apps in about five minutes: six worked, three failed,
//   one of the failures was a certificate rejected for a thumbprint mismatch, and the secrets that did land were set
//   to expire in 2028 (Huntress). A planted secret survives after the original vendor credential is rotated.
//
// Why a separate rule: Microsoft's built-in Sentinel rules for new app credentials ("New access credential added to
// Application or Service Principal" and "First access credential added...", scheduled and NRT) only keep initiators
// with "@" in the name, so they drop changes made by an app. They also only keep Application targets, so a credential
// added to a service principal object falls out too. That's exactly this attack.
//
// Human admins rotating secrets on app registrations are left out on purpose. That's routine noise.
// Run this over 14 days once before you enable it. Anything that shows up is likely your own automation:
// confirm it and add its display name to ApprovedCredentialAutomation.
//
// Tables: AuditLogs
// Run: every 5 minutes with Window = 5m if you can, otherwise hourly with Window = 1h. Severity: Severity column.
// MITRE: T1098.001 Account Manipulation: Additional Cloud Credentials
// Entities: Account (AadUserId) = InitiatorServicePrincipalId, OAuth application = InitiatorAppId, Cloud application = TargetName
let Window = 1h;
let ApprovedCredentialAutomation = dynamic([]);  // display names of your own secret-rotation automation, once confirmed
AuditLogs
| where ingestion_time() > ago(Window)
| where OperationName has_any ("Certificates and secrets management", "Add service principal credentials")
    or (OperationName in~ ("Update application", "Update service principal") and tostring(TargetResources) has "KeyDescription")
| extend
    InitiatorAppId = tostring(InitiatedBy.app.appId),
    InitiatorServicePrincipalId = tostring(InitiatedBy.app.servicePrincipalId),
    InitiatorApp = tostring(InitiatedBy.app.displayName),
    InitiatorUserId = tostring(InitiatedBy.user.id),
    InitiatorUpn = tostring(InitiatedBy.user.userPrincipalName)
| extend InitiatedByApp = (isnotempty(InitiatorServicePrincipalId) or isnotempty(InitiatorAppId)) and isempty(InitiatorUserId)
| where not(InitiatorApp in~ (ApprovedCredentialAutomation))
| mv-apply Target = TargetResources on (
    where tostring(Target.type) in~ ("Application", "ServicePrincipal")
    | take 1
    | project
        TargetType = tostring(Target.type),
        TargetId = tostring(Target.id),
        TargetName = tostring(Target.displayName),
        TargetProps = Target.modifiedProperties
    )
// mv-apply drops a row when the array is empty, and failed attempts can come with no modified properties.
// One placeholder element keeps those rows.
| extend
    TargetProps = iff(array_length(TargetProps) > 0, TargetProps, dynamic([{"displayName": "none"}])),
    DetailsToRead = iff(array_length(AdditionalDetails) > 0, AdditionalDetails, dynamic([{"key": "none", "value": ""}]))
| mv-apply Prop = TargetProps on (
    summarize
        NewKeys = take_anyif(tostring(Prop.newValue), tostring(Prop.displayName) == "KeyDescription"),
        OldKeys = take_anyif(tostring(Prop.oldValue), tostring(Prop.displayName) == "KeyDescription")
    )
| extend
    NewKeyList = iff(isempty(NewKeys), dynamic([]), todynamic(NewKeys)),
    OldKeyList = iff(isempty(OldKeys), dynamic([]), todynamic(OldKeys))
| extend AddedKeys = set_difference(NewKeyList, OldKeyList)
| extend AddedKeyCount = array_length(AddedKeys)
// Each key looks like [KeyIdentifier=<guid>,KeyType=Password,KeyUsage=Verify,DisplayName=<name>]
| extend FirstAddedKey = tostring(AddedKeys[0])
| extend
    KeyId = extract(@"KeyIdentifier=([0-9a-fA-F-]{36})", 1, FirstAddedKey),
    KeyType = extract(@"KeyType=([^,\]]+)", 1, FirstAddedKey),
    KeyUsage = extract(@"KeyUsage=([^,\]]+)", 1, FirstAddedKey),
    KeyName = extract(@"DisplayName=([^\]]*)", 1, FirstAddedKey)
// Keep additions and failures. Removals alone aren't this attack.
| where AddedKeyCount > 0 or Result =~ "failure"
| mv-apply Detail = DetailsToRead on (
    summarize UserAgent = take_anyif(tostring(Detail.value), tostring(Detail.key) =~ "User-Agent")
    )
| extend ChangedAnotherApp = InitiatedByApp and not(TargetName =~ InitiatorApp)
| where InitiatedByApp or (TargetType =~ "ServicePrincipal" and KeyUsage =~ "Verify")
| extend Severity = iff(InitiatedByApp, "High", "Medium")
| extend AddedBy = coalesce(InitiatorApp, InitiatorUpn, InitiatorAppId)
| project
    TimeGenerated,
    Severity,
    AddedBy,
    OperationName,
    Result,
    ResultReason,
    InitiatedByApp,
    InitiatorApp,
    InitiatorAppId,
    InitiatorServicePrincipalId,
    InitiatorUpn,
    ChangedAnotherApp,
    TargetType,
    TargetName,
    TargetId,
    AddedKeyCount,
    KeyId,
    KeyType,
    KeyUsage,
    KeyName,
    AddedKeys,
    UserAgent,
    CorrelationId
| order by TimeGenerated asc
